import ifj26.*

case class Point(x: Int, y: Int)

def total(v: Int | Point): Int =
    v match
        case Point(a, b) => a + b
        case n: Int => n
        case _ => 0

@main
def main(): Unit =
    val p: Int | Point = Point(3, 4)
    val n = total(p)
    print(n)
    print("\n")
