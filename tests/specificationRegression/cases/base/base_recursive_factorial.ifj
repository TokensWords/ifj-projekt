// AI-generated regression fixture; specification references and prompt are in README.md.
import ifj26.*

def fact(n: Int): Int =
    if n <= 1 then
        return 1
    else
        val prev = n - 1
        val rest = fact(prev)
        return n * rest

@main
def main(): Unit =
    val x = fact(5)
    print(x)
    print("\n")
